const TIPOS_ETAPA = { mensagem: "Mensagem", pergunta: "Pergunta", memoria: "Memória", tag: "Etiqueta", condicao: "Condição", handoff: "Passar para humano", notificar: "Avisar a Sede", encerrar: "Encerrar" };
const OPERADORES_FLUXO = [["igual", "é igual a"], ["diferente", "é diferente de"], ["contem", "contém"], ["nao_contem", "não contém"], ["comeca_com", "começa com"], ["em_lista", "está na lista (separe por vírgula)"], ["maior", "é maior que (número)"], ["menor", "é menor que (número)"], ["existe", "foi respondida"], ["nao_existe", "está vazia"]];
const VARIAVEIS_FLUXO = "Já conhecidas: nome, canal, unidade, unidade_tipo (setor, campo, igreja…), igreja e origem (“sede” quando a pessoa não é de nenhuma igreja).";
// Modelos prontos: criam as etapas; a pessoa só confere e ajusta.
const MODELOS_FLUXO = {
  documento_sede: ["Documento só a Sede emite → Sede", [
    { tipo: "mensagem", texto: "Olá, {{nome}}! Vou registrar o seu pedido." },
    { tipo: "pergunta", texto: "Qual documento você precisa?", variavel: "documento", opcoes: ["Carta de recomendação", "Certidão", "Outro"] },
    { tipo: "tag", tag: "documento" },
    { tipo: "handoff", destino: "sede", liberacao: true, texto: "Pedido enviado à Sede. Assim que for liberado, você receberá a resposta aqui." }]],
  oracao_sede: ["Oração designada à Sede", [
    { tipo: "pergunta", texto: "Seu pedido de oração é para a liderança da Sede?", variavel: "para_sede", opcoes: ["Sim", "Não"] },
    { tipo: "condicao", variavel: "para_sede", operador: "igual", valor: "Sim", ir_para: 3, senao_ir_para: 5 },
    { tipo: "notificar", texto: "Novo pedido de oração para a Sede ({{unidade}})." },
    { tipo: "handoff", destino: "sede", texto: "A liderança da Sede recebeu o seu pedido. Estamos orando por você." },
    { tipo: "mensagem", texto: "Sua igreja vai cuidar do seu pedido. Deus abençoe!" },
    { tipo: "handoff", destino: "fila" }]],
  filtro_setor: ["Setor resolve; Sede só se for de documentos", [
    { tipo: "pergunta", texto: "Sobre o que é o seu pedido?", variavel: "assunto", opcoes: ["Documento", "Visita pastoral", "Outro"] },
    { tipo: "condicao", variavel: "assunto", operador: "igual", valor: "Documento", ir_para: 3, senao_ir_para: 4 },
    { tipo: "handoff", destino: "sede", liberacao: true },
    { tipo: "handoff", destino: "fila" }]],
};

async function editarFluxo(fluxo) {
  const [filas, servicos, contatos] = await Promise.all([api("/api/filas"), api("/api/servicos").catch(() => []), api("/api/contatos").catch(() => [])]);
  const etapas = JSON.parse(JSON.stringify(fluxo ? fluxo.etapas : [{ tipo: "mensagem", texto: "Olá, {{nome}}! Bem-vindo à {{empresa}}." }]));
  const cab = h("div", { class: "formulario" },
    campo("Nome do fluxo", entrada("nome", fluxo ? fluxo.nome : "")),
    campo("Começar de um modelo pronto", (() => { const m = seletor("modelo", [["", "— em branco —"], ...Object.entries(MODELOS_FLUXO).map(([k, v]) => [k, v[0]])], ""); m.addEventListener("change", () => { if (!m.value) return; etapas.splice(0, etapas.length, ...JSON.parse(JSON.stringify(MODELOS_FLUXO[m.value][1]))); desenhar(); }); return m; })(), "Preenche as etapas para você conferir e ajustar; as filas continuam por sua escolha.", true),
    campo("Quando começa", seletor("gatilho_tipo", [["sempre", "Sempre que alguém chama"], ["palavra_chave", "Quando a mensagem tem uma palavra-chave"], ["manual", "Manual (não começa sozinho)"]], fluxo ? fluxo.gatilho_tipo : "sempre")),
    campo("Palavra-chave", entrada("gatilho_valor", fluxo ? fluxo.gatilho_valor || "" : "", { placeholder: "orçamento" }), "Só para o gatilho de palavra-chave."));
  // ---- listas de escolha (nada de digitar o que já existe no sistema)
  const semAcento = (t) => String(t || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
  const nomeValido = (t) => semAcento(t).replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").replace(/^(\d)/, "_$1").slice(0, 40);
  const SISTEMA = { nome: { rot: "Nome da pessoa" }, canal: { rot: "Canal (site, WhatsApp…)", opcoes: ["web", "whatsapp", "portal", "interno"] },
    unidade: { rot: "Setor/igreja da pessoa" }, unidade_tipo: { rot: "Tipo do local da pessoa", opcoes: ["setor", "campo", "igreja", "congregacao", "departamento"] },
    igreja: { rot: "Igreja da pessoa" }, origem: { rot: "De onde vem (Sede ou unidade)", opcoes: ["sede", "unidade"] } };
  const SUGESTOES_NOME = ["assunto", "documento", "para_sede", "motivo", "detalhe"];
  const ativos = servicos.filter((x) => x.ativo !== 0);
  const DOS_SERVICOS = ativos.map((x) => x.nome);
  const tagsConhecidas = () => [...new Set([...(contatos || []).flatMap((c) => c.tags || []), ...etapas.filter((x) => x.tipo === "tag" && x.tag).map((x) => x.tag),
    "documento", "oração", "visita", "batismo", "ajuda social", ...DOS_SERVICOS.filter((n) => n.length <= 30)])].sort((a, b) => a.localeCompare(b, "pt-BR"));
  // memórias que a etapa i já pode ler: informações do sistema + perguntas/memórias das etapas de antes
  function variaveisAte(i) {
    const v = {}; Object.entries(SISTEMA).forEach(([k, d]) => { v[k] = { rot: d.rot, opcoes: d.opcoes || null }; });
    etapas.slice(0, i).forEach((x) => {
      if (!x.variavel || SISTEMA[x.variavel]) return;
      if (x.tipo === "pergunta") v[x.variavel] = { rot: `Resposta da pergunta “${(x.texto || "").slice(0, 28)}”`, opcoes: (x.opcoes && x.opcoes.length) ? x.opcoes : null };
      else if (x.tipo === "memoria") v[x.variavel] = { rot: "Valor guardado na memória", opcoes: null };
    });
    return v;
  }
  function seletorNome(e) {
    const usados = [...new Set([...etapas.filter((x) => x.variavel && !SISTEMA[x.variavel]).map((x) => x.variavel), ...SUGESTOES_NOME])];
    if (e.variavel && !usados.includes(e.variavel) && !SISTEMA[e.variavel]) usados.push(e.variavel);
    const sel = seletor("v", [["", "— escolha o nome —"], ...usados.map((n) => [n, n]), ["__novo", "✎ Criar outro nome…"]], e.variavel && !SISTEMA[e.variavel] ? e.variavel : "");
    const novo = entrada("vn", "", { placeholder: "ex.: tipo_de_pedido" }); novo.style.display = "none"; novo.style.marginTop = "6px";
    sel.addEventListener("change", () => { if (sel.value === "__novo") { novo.style.display = ""; novo.focus(); } else { novo.style.display = "none"; e.variavel = sel.value; desenhar(); } });
    novo.addEventListener("change", () => { const n = nomeValido(novo.value); if (n) { e.variavel = n; desenhar(); } });
    return h("div", null, sel, novo);
  }
  function listaOpcoes(e) {   // marcar as respostas possíveis (vindas dos Serviços) + criar outras
    const marcadas = e.opcoes || (e.opcoes = []);
    const candidatas = [...new Set([...marcadas, ...DOS_SERVICOS, "Sim", "Não", "Outro"])];   // as já marcadas ficam no topo
    const caixa = h("div", { class: "opcoes-fluxo", style: { display: "grid", gap: "4px", maxHeight: "190px", overflow: "auto", padding: "6px", border: "1px solid var(--borda, #ccc)", borderRadius: "8px" } });
    candidatas.forEach((nome) => {
      const longa = nome.length > 24;
      const cx = h("input", { type: "checkbox" }); cx.checked = marcadas.includes(nome); cx.disabled = longa && !cx.checked;
      cx.addEventListener("change", () => { const j = marcadas.indexOf(nome); if (cx.checked && j < 0) marcadas.push(nome); if (!cx.checked && j >= 0) marcadas.splice(j, 1); desenhar(); });
      caixa.append(h("label", { class: "opcao-check", title: longa ? "Nome com mais de 24 letras: encurte em Serviços para usar como botão." : "" }, cx, " ", nome, longa ? " (nome longo demais)" : ""));
    });
    const outra = entrada("no", "", { placeholder: "Outra opção (até 24 letras)", maxlength: "24" });
    const add = h("button", { class: "btn pequeno", type: "button", text: "+ Adicionar", on: { click: () => { const t = outra.value.trim(); if (t && !marcadas.some((m) => semAcento(m) === semAcento(t))) { marcadas.push(t); desenhar(); } } } });
    return h("div", null, caixa, h("div", { class: "acoes", style: { marginTop: "6px" } }, outra, add));
  }
  function seletorEtapa(e, chave, i, vazio) {
    const sel = seletor(chave, [["", vazio], ...etapas.map((x, j) => [String(j + 1), `${j + 1}. ${TIPOS_ETAPA[x.tipo] || x.tipo}${x.texto ? " — " + x.texto.slice(0, 30) : ""}`]).filter(([n]) => Number(n) !== i + 1)], e[chave] ? String(e[chave]) : "");
    sel.addEventListener("change", () => { e[chave] = sel.value ? Number(sel.value) : null; });
    return sel;
  }
  function inserirMemoria(e, area, i) {   // botões que colocam {{nome}}, {{unidade}}… no texto
    const v = variaveisAte(i);
    return h("div", { class: "acoes", style: { flexWrap: "wrap", marginTop: "4px" } }, h("span", { class: "suave", text: "Inserir:" }),
      Object.keys(v).map((n) => h("button", { class: "btn pequeno", type: "button", text: n, title: v[n].rot, on: { click: () => { area.value += `{{${n}}}`; e.texto = area.value; area.focus(); } } })));
  }
  const lista = h("div");
  const resultado = h("div", { class: "simulacao" }, h("div", { class: "suave", text: "Escreva as respostas do cliente (uma por linha) e clique em Simular." }));
  const entradas = areaTexto("entradas", "Orçamento", { rows: 3 });
  const como = seletor("como", [["sede", "uma pessoa da Sede (sem igreja)"], ["igreja", "uma pessoa de uma igreja"], ["setor", "uma pessoa de um setor"], ["campo", "uma pessoa de um campo"]], "sede");
  function desenhar() {
    limpar(lista);
    etapas.forEach((e, i) => {
      const f = (chave, el) => { el.addEventListener("input", () => { e[chave] = el.type === "number" ? (el.value ? Number(el.value) : null) : el.value; }); return el; };
