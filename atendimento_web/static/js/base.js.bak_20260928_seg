/* RMD Atendimento — base da interface (sem bibliotecas externas).
   Regra de segurança: nenhum texto vindo do servidor entra como HTML;
   tudo é montado com h() e textContent. */
"use strict";

const App = { sessao: null, telas: {}, atual: null, intervalos: [], limpezaTela: null };

/* ---------------------------------------------------------------- utilidades */
function h(tag, atributos, ...filhos) {
  const el = document.createElement(tag);
  const a = atributos || {};
  for (const [chave, valor] of Object.entries(a)) {
    if (valor === null || valor === undefined || valor === false) continue;
    if (chave === "class") el.className = valor;
    else if (chave === "text") el.textContent = valor;
    else if (chave === "on") for (const [ev, fn] of Object.entries(valor)) el.addEventListener(ev, fn);
    else if (chave === "style" && typeof valor === "object") Object.assign(el.style, valor);
    else if (chave === "dataset") Object.assign(el.dataset, valor);
    else if (chave in el && typeof valor !== "string") el[chave] = valor;
    else el.setAttribute(chave, valor === true ? "" : String(valor));
  }
  for (const f of filhos.flat(Infinity)) {
    if (f === null || f === undefined || f === false) continue;
    el.append(f instanceof Node ? f : document.createTextNode(String(f)));
  }
  return el;
}
const $ = (s, raiz = document) => raiz.querySelector(s);
function limpar(el) { while (el.firstChild) el.removeChild(el.firstChild); return el; }

async function api(caminho, opcoes = {}) {
  const metodo = opcoes.metodo || (opcoes.dados !== undefined ? "POST" : "GET");
  const cfg = { method: metodo, headers: { "X-RMD": "1" }, credentials: "same-origin" };
  if (opcoes.dados !== undefined) { cfg.headers["Content-Type"] = "application/json"; cfg.body = JSON.stringify(opcoes.dados); }
  const r = await fetch(caminho, cfg);
  let corpo = null;
  try { corpo = await r.json(); } catch (_) { corpo = null; }
  if (!r.ok) {
    if (r.status === 401 && corpo && corpo.sessao === false && !opcoes.semRedirecionar) { App.sessao = null; iniciar(); }
    if (r.status === 403 && corpo && corpo.trocar_senha) { App.sessao.usuario.trocar_senha = true; montarTrocaSenha(); }
    const erro = new Error((corpo && corpo.erro) || `Erro ${r.status}`);
    erro.status = r.status; erro.corpo = corpo;
    throw erro;
  }
  return corpo;
}

function toast(texto, tipo = "ok") {
  const t = h("div", { class: "toast" + (tipo === "erro" ? " erro" : ""), role: "status", text: texto });
  $("#toasts").append(t);
  setTimeout(() => t.remove(), tipo === "erro" ? 6500 : 3500);
}
function falha(erro) { toast(erro && erro.message ? erro.message : String(erro), "erro"); }

function modal({ titulo, subtitulo, conteudo, acoes = [], larga = false, aoFechar }) {
  const fundo = h("div", { class: "modal", role: "dialog", "aria-modal": "true" });
  const fechar = () => { fundo.remove(); document.removeEventListener("keydown", esc); if (aoFechar) aoFechar(); };
  const esc = (e) => { if (e.key === "Escape") fechar(); };
  document.addEventListener("keydown", esc);
  const botoes = acoes.map((a) => {
    const b = h("button", { class: "btn " + (a.classe || ""), type: "button", text: a.texto });
    b.addEventListener("click", async () => {
      if (!a.acao) return fechar();
      b.disabled = true;
      try { const r = await a.acao(fechar); if (r !== false && a.fecha !== false) fechar(); }
      catch (e) { falha(e); }
      finally { b.disabled = false; }
    });
    return b;
  });
  const caixa = h("div", { class: "caixa-modal" + (larga ? " larga" : "") },
    h("div", { class: "linha-titulo" }, h("div", null, h("h2", { text: titulo }), subtitulo ? h("div", { class: "suave", text: subtitulo }) : null),
      h("button", { class: "btn pequeno", type: "button", "aria-label": "Fechar", text: "✕", on: { click: fechar } })),
    conteudo, botoes.length ? h("div", { class: "rodape-modal" }, botoes) : null);
  fundo.append(caixa);
  fundo.addEventListener("mousedown", (e) => { if (e.target === fundo) fechar(); });
  document.body.append(fundo);
  const primeiro = caixa.querySelector("input,select,textarea");
  if (primeiro) setTimeout(() => primeiro.focus(), 30);
  return { fechar, caixa };
}

function confirmar(texto, botao = "Confirmar", classe = "primario") {
  return new Promise((ok) => {
    modal({ titulo: "Confirmar", conteudo: h("p", { text: texto }), aoFechar: () => ok(false),
      acoes: [{ texto: "Cancelar" }, { texto: botao, classe, acao: (fechar) => { ok(true); fechar(); return false; } }] });
  });
}

function mostrarSegredo(titulo, rotulo, valor, aviso) {
  modal({ titulo, conteudo: h("div", null,
    h("p", { class: "suave", text: aviso || "" }),
    h("div", { class: "campo" }, h("label", { text: rotulo }), h("pre", { class: "mono", text: valor })),
    h("button", { class: "btn", type: "button", text: "Copiar", on: { click: () => navigator.clipboard.writeText(valor).then(() => toast("Copiado.")) } })),
    acoes: [{ texto: "Entendi", classe: "primario" }] });
}

