      campo("Código de primeiro acesso", entrada("codigo", "", { required: true, autocomplete: "off" })),
      campo("Nome da empresa", entrada("empresa", "", { required: true })),
      campo("Seu nome", entrada("nome", "", { required: true })),
      campo("Seu e-mail", entrada("email", "", { type: "email", required: true })),
      campo("Senha", entrada("senha", "", { type: "password", required: true, autocomplete: "new-password" }), "Mínimo 8 caracteres, com letras e números."),
      erro, h("button", { class: "btn primario", type: "submit", text: "Criar e entrar" }));
