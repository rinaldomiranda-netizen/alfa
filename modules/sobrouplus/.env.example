# Modelo sem segredos — preencha somente no ambiente protegido do servidor Sobrou+.
# Para publicar externamente, marque o modo público e confirme HTTPS no proxy/reverse proxy.
SOBROU_PUBLICO=0
SOBROU_HTTPS=0
SOBROU_ATRAS_DE_PROXY=0

SOBROU_PAYMENT_PROVIDER=mercadopago
SOBROU_PAYMENT_ENV=sandbox
SOBROU_PAYMENT_WEBHOOK_URL=https://SEU-DOMINIO/api/webhooks/mercadopago
SOBROU_PAYMENT_MAX_INSTALLMENTS=12

MERCADOPAGO_PUBLIC_KEY_SANDBOX=
MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET_SANDBOX=

MERCADOPAGO_PUBLIC_KEY_PRODUCTION=
MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=
