function navegar(tela, parametros) {
  const alvo = "#/" + tela + (parametros ? "/" + encodeURIComponent(parametros) : "");
  if (location.hash === alvo) mostrarTela(); else location.hash = alvo;
}

async function mostrarTela() {
  if (!App.sessao) return;
  const [, tela, parametro] = (location.hash || "").split("/");
  const permitidas = App.sessao.telas;
  const chave = permitidas.includes(tela) ? tela : permitidas[0];
  const def = App.telas[chave];
  if (!def) return;
  if (App.limpezaTela) { try { App.limpezaTela(); } catch (_) { /* ignora */ } App.limpezaTela = null; }
  App.atual = chave;
  document.querySelectorAll(".nav button").forEach((b) => b.classList.toggle("ativo", b.dataset.tela === chave));
  $("#lateral").classList.remove("aberta");
  const area = limpar($("#conteudo"));
  const acoes = h("div", { class: "acoes" });
  area.append(h("div", { class: "titulo-pagina" }, h("div", null, h("h1", { text: def.titulo }), h("p", { text: def.sub || "" })), acoes));
  const corpo = h("div");
  area.append(corpo);
  document.title = `${def.titulo} — ${(App.sessao.empresa && App.sessao.empresa.nome_sistema) || "RMD Atendimento"}`;
  try { await def.render(corpo, { acoes, parametro: parametro ? decodeURIComponent(parametro) : null }); }
  catch (e) { corpo.append(h("div", { class: "aviso", text: e.message })); }
}

