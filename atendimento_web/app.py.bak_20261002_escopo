    @rota("GET", "/api/health", "publico")
    def r_saude(self):
        plataforma().banco.um("SELECT 1 AS ok")
        return {"ok": True, "servico": NOME_EDICAO, "versao": VERSAO, "edicao": EDICAO}

    @rota("GET", "/api/sessao")
    def r_sessao(self):
        if self.ator is None:
            return {"sessao": False, "primeiro_acesso": not plataforma().existe_usuario(), "versao": VERSAO, "edicao": EDICAO}
        return {"sessao": True, **self._perfil_publico()}

    @rota("POST", "/api/entrar")
    def r_entrar(self):
        if not LIMITE_LOGIN_IP.permitir(self._ip()):
            raise ErroNegocio("Muitas tentativas. Espere um minuto.")
        dados = self._corpo()
        try:
            token, self.ator = plataforma().entrar(dados.get("email"), dados.get("senha"), self._ip(), self.headers.get("User-Agent"),
                                                   codigo=dados.get("codigo"))
        except PrecisaCodigo as erro:
            return self._json({"erro": str(erro), "precisa_codigo": True, "sessao": False}, 401)
        self._json({"sessao": True, **self._perfil_publico()}, cabecalhos=self._cookie_sessao(token))

    @rota("GET", "/entrar")
    def r_entrar_link(self):
        token_unico = self.consulta.get("token", "")
        try:
            token, _ = plataforma().entrar_com_token_unico(token_unico, self._ip(), self.headers.get("User-Agent"))
        except NaoAutenticado as erro:
            raise Resposta(401, f"<!doctype html><meta charset=utf-8><p style='font-family:sans-serif'>{erro}</p>".encode(), "text/html; charset=utf-8")
        raise Resposta(303, b"", cabecalhos={"Location": "/", **self._cookie_sessao(token)})

    @rota("POST", "/api/primeiro-acesso")
    def r_primeiro_acesso(self):
        p = plataforma()
        if p.existe_usuario():
            raise ErroNegocio("O primeiro acesso já foi feito.")
        dados = self._corpo()
        if not secrets.compare_digest(str(dados.get("codigo", "")).strip().upper(), _codigo_primeiro_acesso()):
            raise ErroNegocio("Código de primeiro acesso incorreto (ele aparece na janela do servidor).")
        empresa = p.criar_empresa(dados.get("empresa") or "Minha empresa", plano=dados.get("plano") or "essencial")
        p.criar_usuario(None, dados.get("nome"), dados.get("email"), "admin", senha=dados.get("senha"), empresa_id=empresa["id"])
        token, self.ator = p.entrar(dados.get("email"), dados.get("senha"), self._ip(), self.headers.get("User-Agent"))
        (pasta_dados() / "primeiro_acesso.txt").unlink(missing_ok=True)
        if EDICAO:
            p.salvar_config(self.ator, {"nome_sistema": NOME_EDICAO})
        self._json({"sessao": True, **self._perfil_publico()}, cabecalhos=self._cookie_sessao(token))

