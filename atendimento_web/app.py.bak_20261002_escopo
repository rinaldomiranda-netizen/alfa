    def _perfil_publico(self) -> dict:
        a = self.ator
        p = plataforma()
        config = p.obter_config(a.empresa_id) if a.empresa_id else None
        if config:
            config = {k: config[k] for k in ("empresa_nome", "empresa_slug", "nome_sistema", "logo", "tema", "cor_destaque", "fuso",
                                             "mensagem_inicial", "atribuicao_automatica", "pedir_avaliacao", "demonstracao", "plano")}
        return {
            "usuario": {"id": a.usuario_id, "nome": a.nome, "email": a.email, "perfil": a.perfil,
                        "perfil_nome": permissoes.NOMES_PERFIS[a.perfil], "fila_id": a.fila_id, "contato_id": a.contato_id,
                        "trocar_senha": a.trocar_senha},
            "empresa": config,
            "telas": permissoes.telas_do_perfil(a.perfil, EDICAO == "church") if a.empresa_id or a.perfil != "owner" else ["companies", "security"],
            "permissoes": permissoes.permissoes_do_perfil(a.perfil),
            "temas": NOMES_TEMAS,
            "versao": VERSAO,
            "alertas": p.contar_alertas(a.empresa_id) if a.empresa_id and a.pode("alertas") else 0,
        }

