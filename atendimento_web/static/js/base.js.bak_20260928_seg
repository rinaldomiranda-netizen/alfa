function marcador(nome, marcado, texto) {
  return h("label", { class: "opcao-check" }, h("input", { type: "checkbox", name: nome, checked: !!marcado }), texto);
}
function lerFormulario(raiz) {
  const dados = {};
  raiz.querySelectorAll("input[name],select[name],textarea[name]").forEach((el) => {
    if (el.type === "checkbox") dados[el.name] = el.checked;
    else dados[el.name] = el.value;
  });
  return dados;
}

/* formatação */
function fuso() { return (App.sessao && App.sessao.empresa && App.sessao.empresa.fuso) || "America/Maceio"; }
function moeda(centavos) { return ((centavos || 0) / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }); }
function dataHora(iso) { if (!iso) return "—"; try { return new Date(iso).toLocaleString("pt-BR", { timeZone: fuso(), day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }); } catch (_) { return iso; } }
function data(iso) { if (!iso) return "—"; if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) { const [a, m, d] = iso.split("-"); return `${d}/${m}/${a}`; } try { return new Date(iso).toLocaleDateString("pt-BR", { timeZone: fuso() }); } catch (_) { return iso; } }
function hora(iso) { try { return new Date(iso).toLocaleTimeString("pt-BR", { timeZone: fuso(), hour: "2-digit", minute: "2-digit" }); } catch (_) { return ""; } }
function relativo(iso) {
  if (!iso) return "—";
  const s = Math.round((Date.now() - new Date(iso).getTime()) / 1000);
  if (s < 60) return "agora"; if (s < 3600) return `há ${Math.floor(s / 60)} min`;
  if (s < 86400) return `hoje, ${hora(iso)}`; return dataHora(iso);
}
function mmss(segundos) { if (segundos === null || segundos === undefined) return "—"; const neg = segundos < 0; const s = Math.abs(segundos); const t = `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`; return neg ? `-${t}` : t; }
function iniciais(nome) { return (nome || "?").replace(/[^\p{L}\p{N}\s]/gu, " ").split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join("") || "?"; }
function telefone(t) { if (!t) return "—"; const d = t.replace(/^55/, ""); if (d.length === 11) return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`; if (d.length === 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`; return "+" + t; }

