<?xml version="1.0" encoding="utf-8"?>
<!-- Emblema BETA: anel neon (presença/IA) + núcleo luminoso + arco
     dourado discreto — dentro da "zona segura" de 66dp do ícone
     adaptativo (canvas de 108dp), para não ser cortado em nenhum
     formato de máscara (círculo, quadrado arredondado, etc.). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anel externo neon -->
    <path
        android:strokeColor="#22D3EE"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M54,29 A25,25 0,1 1,53.9 29" />

    <!-- Núcleo luminoso central -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M54,54m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />

    <!-- Arco dourado discreto, sugerindo movimento/inteligência -->
    <path
        android:strokeColor="#D4AF37"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M74,40 A25,25 0,0 1,79 54" />
</vector>
