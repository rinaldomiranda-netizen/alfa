# Copie este arquivo para ".env" (ou defina como variáveis de ambiente
# reais do Windows) e preencha com suas credenciais. NUNCA versione o
# ".env" de verdade — ele contém segredos.
#
# O ALFA carrega essas variáveis do ambiente do processo. Nenhuma
# chave fica hardcoded no código-fonte.

# ---- Motor de voz principal (config/alfa.json -> voz_saida.motor = "azure") ----
# Portal: https://portal.azure.com -> criar recurso "Azure AI services" -> "Speech"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Motor de voz alternativo (voz_saida.motor = "elevenlabs") ----
# Painel: https://elevenlabs.io -> Profile -> API Keys
# ELEVENLABS_VOICE_ID: escolha uma voz em português em elevenlabs.io/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- BETA-CLOUD (config/alfa.json -> cloud.enabled = true) ----
# Projeto de nuvem PRÓPRIO da BETA (diferente do Supabase usado só
# pela pesquisa/atendimento) — ver memory/sync.py. Use SOMENTE a
# chave publishable/anônima aqui; NUNCA a service_role (essa fica só
# no servidor, nunca no cliente).
BETA_CLOUD_PROJECT_URL=
BETA_CLOUD_PUBLISHABLE_KEY=
