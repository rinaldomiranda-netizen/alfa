PLANOS_PADRAO = (
    ("essencial", "Essencial", 1000, 1, 3),
    ("business", "Business", 10000, 3, 15),
    ("enterprise", "Enterprise", 100000, 10, 100),
)

_LOCK_MIGRACAO = threading.Lock()
_MIGRADOS: set[str] = set()


def _abrir(caminho: Path) -> sqlite3.Connection:
    conexao = sqlite3.connect(str(caminho), timeout=15, isolation_level=None, check_same_thread=False)
    conexao.row_factory = sqlite3.Row
    conexao.execute("PRAGMA foreign_keys = ON")
    conexao.execute("PRAGMA busy_timeout = 15000")
    return conexao


def preparar(caminho: Path | str | None = None) -> Path:
    """Cria a pasta, o arquivo e as tabelas (uma vez por processo)."""
    caminho = Path(caminho) if caminho else caminho_banco_padrao()
    chave = str(caminho.resolve())
    with _LOCK_MIGRACAO:
        if chave in _MIGRADOS and caminho.exists():
            return caminho
        caminho.parent.mkdir(parents=True, exist_ok=True)
        conexao = _abrir(caminho)
        try:
            conexao.execute("PRAGMA journal_mode = WAL")
            conexao.execute("CREATE TABLE IF NOT EXISTS versao_esquema (versao INTEGER NOT NULL)")
            linha = conexao.execute("SELECT MAX(versao) AS v FROM versao_esquema").fetchone()
            atual = linha["v"] or 0
            for numero, sql in enumerate(ESQUEMA, start=1):
                if numero > atual:
                    conexao.executescript("BEGIN;" + sql + f"; INSERT INTO versao_esquema(versao) VALUES ({numero}); COMMIT;")
            for plano in PLANOS_PADRAO:
                conexao.execute(
                    "INSERT OR IGNORE INTO planos(codigo, nome, limite_nomes, limite_canais_whatsapp, limite_usuarios) VALUES (?,?,?,?,?)",
                    plano,
                )
        finally:
            conexao.close()
        _MIGRADOS.add(chave)
    return caminho


class Banco:
    """Acesso ao arquivo do banco. Uma conexão curta por operação —
    seguro com várias telas/usuários ao mesmo tempo."""

    def __init__(self, caminho: Path | str | None = None):
        self.caminho = preparar(caminho)

    @contextmanager
    def conexao(self):
        conexao = _abrir(self.caminho)
        try:
            yield conexao
        finally:
            conexao.close()

    @contextmanager
    def transacao(self):
        conexao = _abrir(self.caminho)
        try:
            conexao.execute("BEGIN IMMEDIATE")
            yield conexao
            conexao.execute("COMMIT")
        except BaseException:
            conexao.execute("ROLLBACK")
            raise
        finally:
            conexao.close()

    def um(self, sql: str, parametros=()) -> dict | None:
        with self.conexao() as c:
            linha = c.execute(sql, parametros).fetchone()
            return dict(linha) if linha else None

    def todos(self, sql: str, parametros=()) -> list[dict]:
        with self.conexao() as c:
            return [dict(linha) for linha in c.execute(sql, parametros).fetchall()]

    def executar(self, sql: str, parametros=()) -> int:
        with self.transacao() as c:
            return c.execute(sql, parametros).rowcount

    def proximo_numero(self, conexao: sqlite3.Connection, empresa_id: str, nome: str, inicio: int) -> int:
        """Numeração sequencial por empresa (ex.: atendimento #10001, ORC-1001).
        Precisa ser chamado dentro de uma transação."""
        linha = conexao.execute(
            "SELECT valor FROM contadores WHERE empresa_id=? AND nome=?", (empresa_id, nome)
        ).fetchone()
        valor = (linha["valor"] + 1) if linha else inicio
        conexao.execute(
            "INSERT INTO contadores(empresa_id, nome, valor) VALUES (?,?,?) "
            "ON CONFLICT(empresa_id, nome) DO UPDATE SET valor=excluded.valor",
            (empresa_id, nome, valor),
        )
        return valor
