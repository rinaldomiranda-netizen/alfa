      erro, h("button", { class: "btn primario", type: "submit", text: "Entrar" }));
  }
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    erro.textContent = "";
    try {
      App.sessao = await api(primeiroAcesso ? "/api/primeiro-acesso" : "/api/entrar", { dados: lerFormulario(form), semRedirecionar: true });
      depoisDoLogin();
    } catch (x) { erro.textContent = x.message; }
  });
  raiz.append(h("div", { class: "tela-login" }, h("div", { class: "caixa-login" },
    h("div", { class: "marca", style: { padding: 0 } }, h("div", { class: "icone", text: "R" }), h("div", null, h("b", { style: { color: "var(--texto)" }, text: "RMD Atendimento" }), h("small", { text: "Módulo oficial do ALFA" }))),
    h("h1", { text: primeiroAcesso ? "Configurar" : "Entrar" }), form)));
}

function montarTrocaSenha() {
  const raiz = limpar($("#raiz"));
  const erro = h("div", { class: "erro-texto", role: "alert" });
  const form = h("form", null,
    h("p", { class: "suave", text: "Você entrou com uma senha temporária. Crie a sua senha para continuar." }),
    campo("Senha temporária", entrada("atual", "", { type: "password", required: true })),
    campo("Nova senha", entrada("nova", "", { type: "password", required: true, autocomplete: "new-password" }), "Mínimo 8 caracteres, com letras e números."),
    erro, h("button", { class: "btn primario", type: "submit", text: "Salvar e continuar" }));
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    try { await api("/api/senha", { dados: lerFormulario(form) }); App.sessao.usuario.trocar_senha = false; iniciar(); }
    catch (x) { erro.textContent = x.message; }
  });
  raiz.append(h("div", { class: "tela-login" }, h("div", { class: "caixa-login" }, h("h1", { text: "Nova senha" }), form)));
}

function depoisDoLogin() {
  if (App.sessao.usuario.trocar_senha) return montarTrocaSenha();
  montarAplicacao();
}

async function iniciar() {
  try {
    const s = await api("/api/sessao", { semRedirecionar: true });
    if (!s.sessao) { App.sessao = null; return montarLogin(s.primeiro_acesso); }
    App.sessao = s;
    depoisDoLogin();
  } catch (e) {
    limpar($("#raiz")).append(h("div", { class: "tela-login" }, h("div", { class: "caixa-login" }, h("h1", { text: "Sem conexão" }), h("p", { class: "suave", text: e.message }),
      h("button", { class: "btn primario", type: "button", text: "Tentar de novo", on: { click: iniciar } }))));
  }
}
window.addEventListener("hashchange", mostrarTela);
