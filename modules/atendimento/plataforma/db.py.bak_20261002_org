"""Banco de dados do RMD Atendimento (SQLite, biblioteca padrão do Python).

Por que SQLite: roda dentro do ALFA e também separado, sem instalar
nada, guarda tudo num único arquivo local e aguenta vários acessos ao
mesmo tempo (modo WAL). Todas as tabelas de negócio têm ``empresa_id``:
os dados de uma empresa nunca aparecem para outra.

Toda leitura/escrita passa por este módulo (``conectar``). Se um dia o
RMD Atendimento for para a nuvem (ex.: Supabase/PostgreSQL), só esta
camada e os serviços precisam trocar — as telas e a API continuam iguais.
"""
from __future__ import annotations

import os
import sqlite3
import threading
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from pathlib import Path

RAIZ_ALFA = Path(__file__).resolve().parents[3]
PASTA_DADOS_PADRAO = RAIZ_ALFA / "data" / "rmd_atendimento"


def pasta_dados() -> Path:
    return Path(os.getenv("RMD_ATENDIMENTO_DADOS", str(PASTA_DADOS_PADRAO)))


def caminho_banco_padrao() -> Path:
    return pasta_dados() / "atendimento.db"


def agora() -> str:
    """Data/hora atual em UTC, formato ISO (ex.: 2026-09-25T13:40:00+00:00)."""
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def para_datahora(texto: str | None) -> datetime | None:
    if not texto:
        return None
    try:
        valor = datetime.fromisoformat(texto)
    except ValueError:
        return None
    if valor.tzinfo is None:
        valor = valor.replace(tzinfo=timezone.utc)
    return valor


def somar_minutos(texto: str, minutos: int) -> str:
    base = para_datahora(texto) or datetime.now(timezone.utc)
    return (base + timedelta(minutes=minutos)).isoformat(timespec="seconds")


