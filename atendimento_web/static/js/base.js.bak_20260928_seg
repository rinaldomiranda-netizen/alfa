}
function entrada(nome, valor, extra = {}) { return h("input", { name: nome, value: valor ?? "", ...extra }); }
function areaTexto(nome, valor, extra = {}) { const t = h("textarea", { name: nome, rows: 3, ...extra }); t.value = valor ?? ""; return t; }
function seletor(nome, opcoes, valor, extra = {}) {
  const s = h("select", { name: nome, ...extra }, opcoes.map(([v, t]) => h("option", { value: v, text: t })));
  s.value = valor ?? (opcoes[0] ? opcoes[0][0] : "");
