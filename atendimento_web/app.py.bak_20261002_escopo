def _rotina(parar: threading.Event) -> None:
    while not parar.wait(60):
        try:
            plataforma().rotina()
        except Exception:  # noqa: BLE001
            traceback.print_exc()
        try:
            backup_externo.talvez_enviar(plataforma().banco.caminho)
        except Exception:  # noqa: BLE001
            traceback.print_exc()


class Servidor(ThreadingHTTPServer):
    daemon_threads = True

    def handle_error(self, request, client_address):
        erro = sys.exc_info()[1]
        if isinstance(erro, (ConnectionResetError, BrokenPipeError, TimeoutError)):
            return  # o navegador fechou a conexão no meio: normal, não é erro
        super().handle_error(request, client_address)


def criar_servidor(host: str = HOST, porta: int = PORT) -> ThreadingHTTPServer:
    servidor = Servidor((host, porta), Handler)
    servidor.daemon_threads = True
    parar = threading.Event()
    servidor.parar_rotina = parar
    threading.Thread(target=_rotina, args=(parar,), daemon=True, name="RMDAtendimentoRotina").start()
    return servidor


def _primeira_instalacao(p) -> None:
    """Na primeira vez que o servidor sobe na internet (sem nenhum usuário), cria a conta do dono (owner)
    e a primeira empresa/igreja. Senha inicial 1234 — o sistema OBRIGA a trocar no primeiro login.
    Só roda se RMD_OWNER_EMAIL estiver definido; sem isso vale o primeiro acesso por código de sempre."""
    email = os.getenv("RMD_OWNER_EMAIL", "").strip().lower()
    if not email or p.existe_usuario():
        return
    from modules.atendimento.plataforma import seguranca

    empresa = p.criar_empresa(os.getenv("RMD_PRIMEIRA_EMPRESA") or ("Minha Igreja" if EDICAO else "Minha Empresa"),
                              plano=os.getenv("RMD_PLANO") or "business")
    p.criar_usuario(None, os.getenv("RMD_OWNER_NOME") or "Rinaldo", email, "owner")
    admin_email = os.getenv("RMD_ADMIN_EMAIL", "").strip().lower()
    if admin_email and admin_email != email:
        p.criar_usuario(None, os.getenv("RMD_ADMIN_NOME") or "Administrador", admin_email, "admin", empresa_id=empresa["id"])
    with p.banco.transacao() as c:
        for e in [email] + ([admin_email] if admin_email and admin_email != email else []):
            salt = seguranca.gerar_salt()
            c.execute("UPDATE usuarios SET senha_hash=?, senha_salt=?, trocar_senha=1 WHERE email=?",
                      (seguranca.hash_senha("1234", salt), salt, e))
        if EDICAO:
            c.execute("UPDATE config_empresa SET nome_sistema=? WHERE empresa_id=?", (NOME_EDICAO, empresa["id"]))
    (pasta_dados() / "primeiro_acesso.txt").unlink(missing_ok=True)
    print(f"[{NOME_EDICAO}] Primeira instalação: conta do dono {email} (senha inicial 1234 — troca obrigatória no 1º login).")


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description="RMD Atendimento")
    parser.add_argument("--host", default=HOST)
    parser.add_argument("--porta", type=int, default=PORT)
    args = parser.parse_args(argv if argv is not None else [])
    p = plataforma()
    _primeira_instalacao(p)
    servidor = criar_servidor(args.host, args.porta)
    print(f"[{NOME_EDICAO} {VERSAO}] http://{args.host}:{servidor.server_address[1]}")
    print(f"[RMD Atendimento] dados em: {p.banco.caminho.parent}")
    if args.host not in ("127.0.0.1", "localhost", "::1"):
        print("[RMD Atendimento] ATENÇÃO: aberto para a rede. Use HTTPS na frente (proxy/túnel) antes de expor na internet.")
    if not p.existe_usuario():
        print(f"[RMD Atendimento] Primeiro acesso: abra o endereço acima e use o código {_codigo_primeiro_acesso()}")
    try:
        servidor.serve_forever()
    finally:
        servidor.parar_rotina.set()


if __name__ == "__main__":
    main(sys.argv[1:])
