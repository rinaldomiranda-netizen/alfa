def plataforma() -> Plataforma:
    global _PLATAFORMA
    with _LOCK:
        if _PLATAFORMA is None:
            _PLATAFORMA = Plataforma()
        return _PLATAFORMA


def definir_plataforma(nova: Plataforma) -> None:
    global _PLATAFORMA
    with _LOCK:
        _PLATAFORMA = nova


class Resposta(Exception):
    """Atalho para responder algo que não é JSON (arquivo, redirecionamento)."""

    def __init__(self, status: int, corpo: bytes = b"", tipo: str = "text/plain; charset=utf-8", cabecalhos: dict | None = None):
        super().__init__(status)
        self.status, self.corpo, self.tipo, self.cabecalhos = status, corpo, tipo, cabecalhos or {}


ROTAS: list[tuple[str, re.Pattern, str, str]] = []


def rota(metodo: str, caminho: str, acesso: str = "sessao"):
    """acesso: sessao | publico | api | meta"""
    partes = re.split(r"(\{\w+\})", caminho)
    padrao = re.compile("^" + "".join(
        f"(?P<{p[1:-1]}>[A-Za-z0-9_\\-]+)" if p.startswith("{") else re.escape(p) for p in partes
    ) + "$")

    def registrar(funcao):
        ROTAS.append((metodo, padrao, acesso, funcao.__name__[2:]))
        return funcao

    return registrar


def _codigo_primeiro_acesso() -> str:
    arquivo = pasta_dados() / "primeiro_acesso.txt"
    arquivo.parent.mkdir(parents=True, exist_ok=True)
    if not arquivo.exists():
        arquivo.write_text(secrets.token_hex(4).upper(), encoding="utf-8")
    return arquivo.read_text(encoding="utf-8").strip()


class Handler(BaseHTTPRequestHandler):
    server_version = "RMDAtendimento"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    # ------------------------------------------------------------ infraestrutura
    def log_message(self, formato: str, *args) -> None:
        if os.getenv("RMD_LOG_HTTP"):
            print(f"[HTTP] {self.address_string()} {formato % args}")

    def _seguranca(self) -> None:
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        if self.headers.get("X-Forwarded-Proto") == "https":
            # HSTS: o navegador passa a usar sempre o endereço com cadeado (https), mesmo se digitarem http.
            self.send_header("Strict-Transport-Security", "max-age=31536000; includeSubDomains")
        self.send_header("Permissions-Policy", "camera=(), microphone=(), geolocation=()")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; "
            "connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
        )

    def _enviar(self, status: int, corpo: bytes, tipo: str, cabecalhos: dict | None = None) -> None:
        self.send_response(status)
        self.send_header("Content-Type", tipo)
        self.send_header("Content-Length", str(len(corpo)))
        self.send_header("Cache-Control", "no-store")
        self._seguranca()
        for chave, valor in (cabecalhos or {}).items():
            self.send_header(chave, valor)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(corpo)

    def _json(self, dados, status: int = 200, cabecalhos: dict | None = None) -> None:
        self._enviar(status, json.dumps(dados, ensure_ascii=False, default=str).encode("utf-8"), "application/json; charset=utf-8", cabecalhos)

    def _ip(self) -> str:
        # Atrás de um proxy HTTPS (Railway, túnel) todo pedido chega do IP do
        # proxy; só então vale o IP informado por ele. Sem a variável, o
        # cabeçalho é ignorado (senão qualquer um poderia inventar um IP).
        if ATRAS_DE_PROXY:
            real = (self.headers.get("X-Real-IP") or "").strip()
            encaminhado = (self.headers.get("X-Forwarded-For") or "").split(",")[0].strip()
            if real or encaminhado:
                return real or encaminhado
        return self.client_address[0] if self.client_address else "?"

    def _token(self) -> str | None:
        bruto = self.headers.get("Cookie")
        if not bruto:
            return None
        cookie = SimpleCookie()
        try:
            cookie.load(bruto)
        except Exception:  # noqa: BLE001
            return None
        return cookie[COOKIE].value if COOKIE in cookie else None

    def _cookie_sessao(self, token: str | None) -> dict:
        if token is None:
            return {"Set-Cookie": f"{COOKIE}=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict"}
        seguro = "; Secure" if self.headers.get("X-Forwarded-Proto") == "https" else ""
        return {"Set-Cookie": f"{COOKIE}={token}; Path=/; Max-Age=43200; HttpOnly; SameSite=Strict{seguro}"}

    def _corpo_bruto(self, limite: int) -> bytes:
        self._corpo_lido = True
        tamanho = int(self.headers.get("Content-Length") or 0)
        if tamanho > limite:
            raise ErroNegocio("Conteúdo grande demais.")
        return self.rfile.read(tamanho) if tamanho > 0 else b""

    def _corpo(self, limite: int = LIMITE_CORPO) -> dict:
        bruto = self._corpo_bruto(limite)
        if not bruto:
            return {}
        try:
            dados = json.loads(bruto.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            raise ErroNegocio("JSON inválido.") from None
        if not isinstance(dados, dict):
            raise ErroNegocio("JSON inválido.")
        return dados

    # ------------------------------------------------------------ despacho
    def do_GET(self):
        self._despachar("GET")

    def do_HEAD(self):
        self._despachar("GET")

    def do_POST(self):
        self._despachar("POST")

    def do_PUT(self):
        self._despachar("PUT")

    def _despachar(self, metodo: str) -> None:
        url = urlparse(self.path)
        self.consulta = {k: v[0] for k, v in parse_qs(url.query).items()}
        caminho = url.path
        self._corpo_lido = False
        try:
            self._despachar_rota(metodo, caminho)
        finally:
            # Corpo enviado e não lido (rota que não precisa dele): fecha a conexão para a sobra
            # não se misturar com o próximo pedido do navegador.
            sobra = int(self.headers.get("Content-Length") or 0) if not self._corpo_lido else 0
            if 0 < sobra <= LIMITE_CORPO:
                try:
                    self.rfile.read(sobra)
                except OSError:
                    self.close_connection = True
            elif sobra:
                self.close_connection = True

    def _despachar_rota(self, metodo: str, caminho: str) -> None:
        try:
            if metodo == "GET" and (caminho.startswith("/static/") or caminho in ("/", "/index.html", "/chat", "/recepcao", "/visitante", "/favicon.ico")):
                return self._estatico(caminho)
            for metodo_rota, padrao, acesso, nome in ROTAS:
                achado = padrao.match(caminho)
                if metodo_rota != metodo or not achado:
                    continue
                if metodo != "GET" and acesso in ("sessao", "publico") and self.headers.get("X-RMD") != "1":
                    return self._json({"erro": "Requisição recusada (proteção CSRF)."}, 403)
                self.ator = None
                if acesso == "sessao":
                    self.ator = plataforma().sessao(self._token())
                    if self.ator is None and nome not in ("sessao", "entrar", "primeiro_acesso", "entrar_link", "saude"):
                        return self._json({"erro": "Sua sessão terminou. Entre de novo.", "sessao": False}, 401)
                    if self.ator and self.ator.trocar_senha and nome not in ("sessao", "trocar_senha", "sair"):
                        return self._json({"erro": "Troque a sua senha temporária antes de continuar.", "trocar_senha": True}, 403)
                resultado = getattr(self, "r_" + nome)(**achado.groupdict())
                if resultado is not None:
                    self._json(resultado)
                return
            self._json({"erro": "Endereço não encontrado."}, 404)
        except Resposta as r:
            self._enviar(r.status, r.corpo, r.tipo, r.cabecalhos)
        except SemPermissao as erro:
            self._json({"erro": str(erro)}, 403)
        except ErroNegocio as erro:
            self._json({"erro": str(erro)}, getattr(erro, "codigo_http", 400))
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception:  # noqa: BLE001 - nunca mostra detalhes internos para o navegador
            traceback.print_exc()
            try:
                self._json({"erro": "Erro interno. Tente de novo; se continuar, veja o registro do servidor."}, 500)
            except OSError:
                pass

    def _estatico(self, caminho: str) -> None:
        paginas = {"/": "index.html", "/index.html": "index.html", "/chat": "chat.html", "/recepcao": "recepcao.html", "/visitante": "visitante.html",
                   "/favicon.ico": "img/icone.svg"}
        relativo = paginas.get(caminho) or caminho[len("/static/"):]
        arquivo = (STATIC / relativo).resolve()
        if STATIC.resolve() not in arquivo.parents or not arquivo.is_file():
            return self._json({"erro": "Arquivo não encontrado."}, 404)
        tipo = mimetypes.guess_type(arquivo.name)[0] or "application/octet-stream"
        if tipo.startswith("text/") or tipo in ("application/javascript", "image/svg+xml"):
            tipo += "; charset=utf-8"
        corpo = arquivo.read_bytes()
        if EDICAO and arquivo.suffix == ".html":
            corpo = (corpo.replace(b'<html lang="pt-BR"', f'<html lang="pt-BR" data-edicao="{EDICAO}"'.encode(), 1)
                     .replace(b"<title>RMD Atendimento", f"<title>{NOME_EDICAO}".encode(), 1)
                     .replace(b"</head>", b'<script src="/static/js/edicao.js"></script>\n</head>', 1)
                     .replace(b'<script src="/static/js/inicio.js"></script>',
                              b'<script src="/static/js/telas_igreja.js"></script>\n<script src="/static/js/inicio.js"></script>', 1))
        self._enviar(200, corpo, tipo)

